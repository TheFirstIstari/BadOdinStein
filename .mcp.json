{
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "github-mcp": {
      "type": "stdio",
      "command": "docker",
      "args": ["run", "-i", "--rm", "ghcr.io/github/github-mcp-server", "stdio"]
    },
    "codebase-memory": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "codebase-memory-mcp"]
    }
  }
}
